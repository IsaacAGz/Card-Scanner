# Copy to .env and adjust values as needed.
# When running the API, use: cd app && uvicorn main:app --host 0.0.0.0 --port 8000

# Path to YOLO weights (relative to the app/ working directory)
YOLO_WEIGHTS=mtg_yolo_best.pt

# Required for POST /admin/sync-set
ADMIN_KEY=change-me

# Max upload size for video endpoints (bytes). Default: 500 MB
MAX_VIDEO_BYTES=524288000

# Image crop export limits
MAX_IMAGE_UPLOAD_BYTES=52428800
MAX_IMAGES_PER_REQUEST=50
MAX_ZIP_INPUT_BYTES=524288000
MAX_ZIP_UNCOMPRESSED_BYTES=1073741824

# How long completed crop jobs are kept on disk (hours)
CROP_JOB_TTL_HOURS=24

# Default L2 distance threshold for visual crop deduplication
EMBEDDING_DEDUP_THRESHOLD=100
